{
  "name": "hai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "python3 -m unittest discover -s tests/python -p \"test_*.py\" && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "start": "python3 -m hai_server",
    "dev:server": "python3 -m hai_server"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
