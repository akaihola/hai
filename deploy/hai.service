[Unit]
Description=Hai issue workspace and TASKS.md API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/agent/prg/hai
ExecStart=/etc/profiles/per-user/agent/bin/python3 -m hai_server
Environment=SHELL=/bin/bash
Environment=HOST=127.0.0.1
Environment=PORT=4173
Environment=HAI_TASKS_FILE=/home/agent/prg/hai/TASKS.md
Environment=HAI_DIST_DIR=/home/agent/prg/hai/dist
Environment=HAI_PROJECT_ROOTS=%h/prg:%h/repos
EnvironmentFile=%h/.config/hai/hai.env
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
